<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Smart Public Transport Companion – Prototype</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Noto+Sans+Kannada:wght@400;600;700&display=swap">
<style>
:root{--bg:#F4F7FA;--card:#fff;--tx:#1F2937;--tx2:#4B5563;--bd:#E5E7EB;--navy:#0B2545;--teal:#0B7A72;--chip:#E8EEF6;--chipx:#0B2545;--g:#DDF4EE;--gx:#075E57;--a:#FDEBC8;--ax:#7A4B00;--r:#FAD4D4;--rx:#8A1C1C;color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0F172A;--card:#1E293B;--tx:#E5E7EB;--tx2:#A5B0C0;--bd:#334155;--chip:#334155;--chipx:#E5E7EB;--g:#0E3B36;--gx:#9FE7DC;--a:#4A3510;--ax:#F7D08A;--r:#4A1B1B;--rx:#F7B4B4;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#0F172A;--card:#1E293B;--tx:#E5E7EB;--tx2:#A5B0C0;--bd:#334155;--chip:#334155;--chipx:#E5E7EB;--g:#0E3B36;--gx:#9FE7DC;--a:#4A3510;--ax:#F7D08A;--r:#4A1B1B;--rx:#F7B4B4;color-scheme:dark}
html{scroll-padding-top:env(safe-area-inset-top,0px);height:100%}
body{margin:0;height:100%;background:var(--bg);color:var(--tx);font-family:Inter,'Noto Sans Kannada',sans-serif;font-size:15px}
button,input,select{font:inherit;color:inherit}
#app{max-width:440px;height:100%;margin:0 auto;display:flex;flex-direction:column;background:var(--bg)}
body.big{font-size:18px}
header{background:var(--navy);color:#fff;padding:14px 16px;display:flex;flex-direction:column;gap:10px}
header h1{margin:0;font-size:18px}
.row{display:flex;gap:8px;align-items:center}
.seg{display:flex;background:#12355F;border-radius:99px;padding:3px}
.seg button{border:0;background:transparent;color:#fff;min-height:40px;padding:0 14px;border-radius:99px;font-weight:600;cursor:pointer}
.seg button.on{background:#fff;color:var(--navy)}
.lang{margin-left:auto;min-height:44px;padding:0 14px;border:1px solid #fff;border-radius:99px;background:transparent;color:#fff;font-weight:600;cursor:pointer}
main{flex:1;overflow-y:auto;padding:14px;display:flex;flex-direction:column;gap:10px}
nav{display:flex;gap:6px;padding:8px 8px 10px;background:var(--card);border-top:1px solid var(--bd)}
nav button{flex:1;min-height:48px;border:0;border-radius:12px;background:var(--chip);color:var(--chipx);font-weight:600;font-size:12px;cursor:pointer}
nav button.on{background:var(--teal);color:#fff}
.card{background:var(--card);border:1px solid var(--bd);border-radius:14px;padding:12px 14px}
.bus{display:flex;gap:12px;align-items:center}
.num{width:50px;height:50px;border-radius:12px;background:var(--navy);color:#fff;font-weight:700;font-size:19px;display:flex;align-items:center;justify-content:center;flex:none}
.grow{flex:1;display:flex;flex-direction:column;gap:5px}
.sm{font-size:12px;color:var(--tx2)}
.eta{text-align:right}.eta b{font-size:26px;color:var(--tx)}
.pill{display:inline-block;font-size:12px;font-weight:600;padding:3px 10px;border-radius:99px;background:var(--chip);color:var(--chipx);margin-right:4px}
.c0,.c1{background:var(--g);color:var(--gx)}.c2{background:var(--a);color:var(--ax)}.c3{background:var(--r);color:var(--rx)}
.btn{min-height:48px;border:2px solid var(--bd);border-radius:12px;background:var(--card);font-weight:600;cursor:pointer;padding:0 14px}
.btn.pri{background:var(--teal);border-color:var(--teal);color:#fff}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
input[type=text],select{min-height:48px;border:1px solid var(--bd);border-radius:12px;padding:0 12px;background:var(--card);width:100%;box-sizing:border-box}
.tg{display:flex;align-items:center;gap:12px;min-height:56px}.tg input{width:24px;height:24px;accent-color:var(--teal)}
.bub{max-width:80%;padding:10px 14px;border-radius:16px;line-height:1.45;white-space:pre-line}
.me{align-self:flex-end;background:var(--teal);color:#fff}.bot{align-self:flex-start;background:var(--card);border:1px solid var(--bd)}
.bar{flex:1;height:12px;background:var(--bd);border-radius:99px;overflow:hidden}.bar i{display:block;height:12px;border-radius:99px}
#toast{position:fixed;left:50%;bottom:90px;transform:translateX(-50%);background:var(--navy);color:#fff;padding:10px 16px;border-radius:99px;font-size:13px;display:none}
h2{font-size:14px;margin:6px 0 0;color:var(--tx)}
</style>
</head>
<body>
<div id="app">
<header>
<div class="row"><h1 id="ttl"></h1><button class="lang" id="lg" onclick="setLang()"></button></div>
<div class="seg" id="seg"></div>
</header>
<main id="main"></main>
<nav id="nav"></nav>
</div>
<div id="toast" role="status"></div>
<script>
const T={en:{arr:'Arrivals',map:'Live map',plan:'Plan',bot:'Bot',set:'Settings',next:'Next buses',min:'min',late:'late',on:'On time',now:'Arriving',low:'Low-floor',ramp:'Ramp',noramp:'No ramp',step:'Step-free only',read:'Read aloud',how:'On this bus? How full is it?',thx:'Thanks, report added',from:'From',to:'To',find:'Find routes',alerts:'Alerts',lang:'Language',aud:'Audio announcements',big:'Larger text',c0:'Empty',c1:'Seats free',c2:'Standing',c3:'Packed',rid:'Rider',op:'Operator',send:'Send',ph:'Type a stop number',tt:'Timetable',pick:'Choose a route',help:'Try: Stop 42, next, or step-free'},
kn:{arr:'ಆಗಮನಗಳು',map:'ನಕ್ಷೆ',plan:'ಯೋಜನೆ',bot:'ಬಾಟ್',set:'ಸೆಟ್ಟಿಂಗ್‌ಗಳು',next:'ಮುಂದಿನ ಬಸ್‌ಗಳು',min:'ನಿಮಿಷ',late:'ತಡ',on:'ಸಮಯಕ್ಕೆ',now:'ಬರುತ್ತಿದೆ',low:'ತಗ್ಗು ಮಹಡಿ',ramp:'ರ‍್ಯಾಂಪ್',noramp:'ರ‍್ಯಾಂಪ್ ಇಲ್ಲ',step:'ಮೆಟ್ಟಿಲು ರಹಿತ ಮಾತ್ರ',read:'ಓದಿ ಹೇಳು',how:'ಈ ಬಸ್‌ನಲ್ಲಿದ್ದೀರಾ? ಎಷ್ಟು ತುಂಬಿದೆ?',thx:'ಧನ್ಯವಾದಗಳು, ವರದಿ ಸೇರಿಸಲಾಗಿದೆ',from:'ಇಂದ',to:'ಗೆ',find:'ಮಾರ್ಗ ಹುಡುಕಿ',alerts:'ಎಚ್ಚರಿಕೆಗಳು',lang:'ಭಾಷೆ',aud:'ಧ್ವನಿ ಪ್ರಕಟಣೆಗಳು',big:'ದೊಡ್ಡ ಅಕ್ಷರಗಳು',c0:'ಖಾಲಿ',c1:'ಸೀಟುಗಳು ಲಭ್ಯ',c2:'ನಿಂತು ಪ್ರಯಾಣ',c3:'ತುಂಬಿದೆ',rid:'ಪ್ರಯಾಣಿಕ',op:'ನಿರ್ವಾಹಕ',send:'ಕಳುಹಿಸಿ',ph:'ನಿಲ್ದಾಣ ಸಂಖ್ಯೆ ಟೈಪ್ ಮಾಡಿ',tt:'ವೇಳಾಪಟ್ಟಿ',pick:'ಮಾರ್ಗ ಆಯ್ಕೆಮಾಡಿ',help:'ಪ್ರಯತ್ನಿಸಿ: Stop 42, next, step-free'}};
let S={lang:'en',step:false,aud:false,big:false};
try{Object.assign(S,JSON.parse(localStorage.getItem('tp')||'{}'))}catch(e){}
const save=()=>{try{localStorage.setItem('tp',JSON.stringify(S))}catch(e){}};
const t=k=>(T[S.lang]&&T[S.lang][k])||T.en[k]||k;
const STOPS=['Stop 42','Central Station','University Gate','Airport Road','Tech Park'];
const B=[{n:27,d:'Central Station',eta:240,dl:6,cr:1,ok:1},{n:14,d:'University Gate',eta:540,dl:0,cr:2,ok:1},{n:52,d:'Airport Road',eta:780,dl:2,cr:3,ok:0},{n:9,d:'Tech Park',eta:960,dl:1,cr:0,ok:1}];
let mode='rider',view='arr',sel=0,alerts=[{c:'a',h:'Bus 27 delayed',m:'Traffic ahead. New arrival shown on Arrivals.',w:'2 min ago'},{c:'r',h:'Bus 14 cancelled',m:'Next bus in 9 min. Step-free option: Bus 27.',w:'8 min ago'},{c:'g',h:'Bus 52 now has seats',m:'Riders report seats available.',w:'15 min ago'}];
let chat=[{w:'bot',x:t('help')}],planOut='';
const $=id=>document.getElementById(id);
const vis=b=>!S.step||b.ok;
const em=b=>Math.max(0,Math.ceil(b.eta/60));
const clock=s=>new Date(Date.now()+s*1000).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'});
const status=b=>b.dl>=3?`+${b.dl} ${t('min')} ${t('late')}`:t('on');
const etaTxt=b=>b.eta<=30?t('now'):`${em(b)} ${t('min')}`;
function toast(m){const e=$('toast');e.textContent=m;e.style.display='block';clearTimeout(toast.h);toast.h=setTimeout(()=>e.style.display='none',2200)}
function say(x){try{const u=new SpeechSynthesisUtterance(x);u.lang=S.lang==='kn'?'kn-IN':'en-IN';speechSynthesis.cancel();speechSynthesis.speak(u)}catch(e){}}
function pills(b){return `<span class="pill c${b.cr}">${t('c'+b.cr)}</span><span class="pill">${b.ok?t('low'):t('noramp')}</span>`}
function busCard(b){return `<div class="card bus"><div class="num">${b.n}</div><div class="grow"><b>${b.d}</b><span class="sm">${t('tt')} ${clock(b.eta-b.dl*60)} · ${status(b)}</span><div>${pills(b)}</div></div><div class="eta"><b>${em(b)}</b><div class="sm">${t('min')}</div></div></div>`}
function setLang(){S.lang=S.lang==='en'?'kn':'en';save();chat[0].x=t('help');shell();draw()}
function setMode(m){mode=m;view=m==='rider'?'arr':'op';shell();draw()}
function go(v){view=v;shell();draw()}
function shell(){document.body.classList.toggle('big',S.big);$('ttl').textContent='Smart Transit';$('lg').textContent=S.lang==='en'?'EN | ಕನ್ನಡ':'ಕನ್ನಡ | EN';
$('seg').innerHTML=['rider','oper'].map(m=>{const k=m==='rider'?'rider':'operator';return `<button class="${mode===k?'on':''}" onclick="setMode('${k}')">${t(m==='rider'?'rid':'op')}</button>`}).join('');
const tabs=mode==='rider'?[['arr','arr'],['map','map'],['plan','plan'],['bot','bot'],['set','set']]:[['op','op'],['al','alerts']];
$('nav').innerHTML=tabs.map(([v,k])=>`<button class="${view===v?'on':''}" onclick="go('${v}')">${t(k)}</button>`).join('')}
function vArr(){const L=B.filter(vis);return `<h2>${t('next')}</h2>`+(L.map(busCard).join('')||'')+`<button class="btn" onclick="say(B.filter(vis).map(b=>'Bus '+b.n+' '+b.d+', '+etaTxt(b)).join('. '))">${t('read')}</button>`}
function vMap(){const b=B[sel],p=Math.min(1,Math.max(0,1-b.eta/1500));
return `<div class="row" style="flex-wrap:wrap">${B.map((x,i)=>`<button class="btn ${i===sel?'pri':''}" style="min-height:44px" onclick="sel=${i};draw()">${x.n}</button>`).join('')}</div>
<div class="card" style="padding:0"><svg viewBox="0 0 360 260" width="100%" role="img" aria-label="Route map"><rect width="360" height="260" fill="#DCE6F2" opacity=".35"/><path id="rt" d="M20 220 C90 210 110 110 190 120 S300 50 340 30" fill="none" stroke="#0B7A72" stroke-width="7" stroke-linecap="round"/><circle cx="340" cy="30" r="9" fill="#fff" stroke="#0B2545" stroke-width="4"/><text x="318" y="55" font-size="12" font-weight="700" fill="currentColor">You</text><g id="bs"></g></svg></div>
<div class="card"><b>Bus ${b.n} → ${b.d}</b><div class="sm">${etaTxt(b)} (± 2) · ${status(b)}</div><div>${pills(b)}</div></div>
<div class="card"><b>${t('how')}</b><div class="grid" style="margin-top:8px">${[0,1,2,3].map(i=>`<button class="btn" onclick="rep(${i})">${t('c'+i)}</button>`).join('')}</div></div>`}
function bus(){const r=$('rt'),g=$('bs');if(!r||!g)return;const b=B[sel],p=Math.min(1,Math.max(0,1-b.eta/1500)),q=r.getPointAtLength(p*r.getTotalLength());g.innerHTML=`<circle cx="${q.x}" cy="${q.y}" r="15" fill="#0B2545"/><text x="${q.x}" y="${q.y+5}" text-anchor="middle" font-size="13" font-weight="700" fill="#fff">${b.n}</text>`}
function rep(i){B[sel].cr=i;toast(t('thx'));draw()}
function vPlan(){const o=STOPS.map(s=>`<option>${s}</option>`).join('');return `<label class="sm" for="pf">${t('from')}</label><select id="pf">${o}</select><label class="sm" for="pt">${t('to')}</label><select id="pt">${o.replace('<option>Central','<option selected>Central')}</select><button class="btn pri" onclick="findR()">${t('find')}</button><div id="po" style="display:flex;flex-direction:column;gap:10px">${planOut}</div>`}
function findR(){const to=$('pt').value;let L=B.filter(vis);const d=L.filter(b=>b.d===to);const o=L.filter(b=>b.d!==to);let h='';
d.forEach(b=>h+=`<div class="card" style="border:2px solid var(--teal)"><div class="row"><b>Bus ${b.n} direct</b><b style="margin-left:auto">${25+b.n%9} ${t('min')}</b></div><div class="sm">${em(b)} ${t('min')}</div><div>${pills(b)}</div></div>`);
o.slice(0,2).forEach(b=>h+=`<div class="card"><div class="row"><b>Bus ${b.n} + Metro</b><b style="margin-left:auto">${34+b.n%7} ${t('min')}</b></div><div class="sm">1 transfer · ${em(b)} ${t('min')}</div><div>${pills(b)}</div></div>`);
planOut=h||'—';$('po').innerHTML=planOut}
function vBot(){return `<div id="ch" style="display:flex;flex-direction:column;gap:8px;flex:1">${chat.map(m=>`<div class="bub ${m.w==='me'?'me':'bot'}">${m.x}</div>`).join('')}</div><div class="row" style="flex-wrap:wrap"><button class="btn" style="min-height:44px" onclick="ask('Next')">${t('next')}</button><button class="btn" style="min-height:44px" onclick="ask('Step-free')">${t('step')}</button></div><div class="row"><label for="mi" style="position:absolute;left:-9999px">Message</label><input type="text" id="mi" placeholder="${t('ph')}" onkeydown="if(event.key==='Enter')ask()"><button class="btn pri" onclick="ask()">${t('send')}</button></div>`}
function ask(x){const i=$('mi');const q=(x||(i&&i.value)||'').trim();if(!q)return;chat.push({w:'me',x:q});const l=q.toLowerCase();let L=B.filter(vis);if(l.includes('step')){L=B.filter(b=>b.ok)}
const rep=(l.includes('step')||l.includes('next')||/\d/.test(l))?`${STOPS[0]}:\n`+L.slice(0,3).map(b=>`${b.n} ${b.d} · ${etaTxt(b)} · ${t('c'+b.cr)}`).join('\n'):t('help');chat.push({w:'bot',x:rep});draw()}
function vSet(){const tg=(k,l)=>`<div class="card tg"><input type="checkbox" id="s${k}" ${S[k]?'checked':''} onchange="S.${k}=this.checked;save();shell()"><label for="s${k}" style="flex:1;font-weight:600">${l}</label></div>`;
return `<h2>${t('lang')}</h2><div class="grid"><button class="btn ${S.lang==='en'?'pri':''}" onclick="S.lang='en';save();chat[0].x=t('help');shell();draw()">English</button><button class="btn ${S.lang==='kn'?'pri':''}" onclick="S.lang='kn';save();chat[0].x=t('help');shell();draw()">ಕನ್ನಡ</button></div>${tg('step',t('step'))}${tg('aud',t('aud'))}${tg('big',t('big'))}`}
function vAl(){return `<h2>${t('alerts')}</h2>`+alerts.map(a=>`<div class="card" style="border-left:6px solid var(--${a.c==='g'?'gx':a.c==='a'?'ax':'rx'})"><div class="row"><b>${a.h}</b><span class="sm" style="margin-left:auto">${a.w}</span></div><div class="sm">${a.m}</div></div>`).join('')}
function vOp(){const avg=(B.reduce((s,b)=>s+b.dl,0)/B.length).toFixed(1),on=Math.round(100*B.filter(b=>b.dl<3).length/B.length),cr=B.filter(b=>b.cr>=2).length;
const st=(v,l)=>`<div class="card" style="flex:1"><b style="font-size:22px">${v}</b><div class="sm">${l}</div></div>`;
return `<div class="sm">Sample data, live simulation</div><div class="row">${st(on+'%','On time')}${st(avg+' min','Avg delay')}${st(cr,'Crowded')}</div><h2>Delay by route</h2>${B.map(b=>`<div class="row"><b style="width:64px">Route ${b.n}</b><div class="bar"><i style="width:${Math.min(100,b.dl*10)}%;background:var(--${b.dl>=6?'rx':b.dl>=3?'ax':'gx'})"></i></div><b style="width:52px;text-align:right">${b.dl} min</b></div>`).join('')}<h2>Crowding hotspots</h2><div class="card">${B.map(b=>`Route ${b.n}: ${T.en['c'+b.cr]}`).join('<br>')}</div><button class="btn pri" onclick="jam()">Simulate traffic jam on Route 27</button><button class="btn" onclick="reset()">Reset</button>`}
function jam(){B[0].dl+=8;B[0].eta+=480;alerts.unshift({c:'a',h:'Bus 27 delayed '+B[0].dl+' min',m:'Traffic jam detected. ETAs updated for riders.',w:'now'});toast('Riders notified');if(S.aud)say('Bus 27 is delayed');draw()}
function reset(){B[0].dl=6;B[0].eta=240;draw()}
function draw(){const V={arr:vArr,map:vMap,plan:vPlan,bot:vBot,set:vSet,al:vAl,op:vOp};$('main').innerHTML=V[view]();if(view==='map')bus()}
setInterval(()=>{B.forEach(b=>{b.eta-=1;if(b.eta<-20){b.eta=1200+Math.floor(Math.random()*300);b.cr=Math.floor(Math.random()*4)}});if(view==='arr'||view==='map'||view==='op')draw()},1000);
shell();draw();
</script>
</body>
</html>
